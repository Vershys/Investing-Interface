# Server-only credential. Configure the same secret in Sites runtime settings.
# Verify personal/display entitlements with the provider before enabling.
FINNHUB_API_KEY=
# Assistant connection; model can be changed without editing application code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Daily per-user token allowance, including conservative in-flight reservations.
AI_DAILY_TOKEN_LIMIT=360000
# Optional authenticated external scheduler endpoint (not enabled by setting alone).
MONITOR_JOB_TOKEN=
